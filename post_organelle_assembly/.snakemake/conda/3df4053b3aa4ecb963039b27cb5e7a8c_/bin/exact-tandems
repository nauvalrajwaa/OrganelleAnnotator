#!/bin/sh
#
# Find exact tandem repeats in specified file involving an
# exact duplicate of at least the specified length

filename=$1
matchlen=$2

bindir="/Users/user/Downloads/04. Pipeline_NGS/pipeline_assembly/post_organelle_assembly/.snakemake/conda/3df4053b3aa4ecb963039b27cb5e7a8c_/bin"
libdir="/Users/user/Downloads/04. Pipeline_NGS/pipeline_assembly/post_organelle_assembly/.snakemake/conda/3df4053b3aa4ecb963039b27cb5e7a8c_/lib/mummer"
repeatmatch="${bindir}/repeat-match"

if [ -z "$filename" -o -z "$matchlen" ]; then
   echo "USAGE:  $0 <file> <min-match-len>"
   exit 1
fi

#echo "Finding matches and tandem repeats"
# Trick: pipe exit status of first command to exit at end of the pipeline
exec 4>&1; { \
    { "$repeatmatch" -t -n $matchlen $filename; echo $? >&3; } | \
        tail -n +3 | sort -k1n -k2n | awk -f $libdir/tandem-repeat.awk >&4; \
} 3>&1 | exit `cat`

