    conda:
        "envs/circos.yaml"
    shell:
        "python workflow/scripts/create_circos_plot.py {input.gbk} {output.plot}"

# 10. Synteny Analysis
rule synteny_analysis:
    input:
        sample="resources/Tarsius/result_cleaned-tRNA.fas",
        reference="resources/Tarsius/reference.fasta"
    output:
        plot="results/synteny/synteny_plot.png",
        summary="results/synteny/synteny_summary.tsv"
    conda:
        "envs/synteny.yaml"
    threads: 2
    shell:
        "python workflow/scripts/run_synteny_analysis.py {input.sample} {input.reference} {output.plot} {output.summary}"
